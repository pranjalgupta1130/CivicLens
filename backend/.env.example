PROJECT_NAME="CivicLens Backend API"
ENV="development"
# Supabase PostgreSQL Connection String (or SQLite fallback sqlite:///./civiclens.db)
DATABASE_URL="sqlite:///./civiclens.db"
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
API_V1_STR="/api"

# Gemini AI Configuration (optional; defaults to MockGeminiAdapter when key is omitted)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

